{
  "manifest_version": 3,
  "name": "Andrew Companion",
  "version": "0.1.0",
  "description": "Connect your browser to Andrew for requested searches, page reading and browser tasks.",
  "key": "",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "nativeMessaging",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://www.google.com/*",
    "https://duckduckgo.com/*",
    "https://www.bing.com/*",
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://grok.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Andrew Companion"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}